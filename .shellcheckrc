# shellcheck-Konfiguration für betterlint
#
# SC2015: A && B || C is not if-then-else. C may run when A is true.
#   Alle set_result-Aufrufe geben immer 0 zurück — das Muster ist korrekt.
disable=SC2015
#
# SC2087: Quote 'HEREDOC' to make here document expansions explicit.
#   Im Gherkin-Block wird ${FEATURE_FILE} bewusst durch die Shell expandiert.
disable=SC2087
